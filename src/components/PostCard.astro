---
// A single post entry in the vertical card grid shared by the blog index and
// the tag listing pages. Two modes:
//   • interactive (default)     — tags are navigational chips that fill on hover.
//   • current (`activeTag` set)  — used on /blog/tag/[tag]; the matching tag is
//     highlighted as "active" and links back to /blog instead of its own page.
// The `featured` flag (blog index's newest post) makes the card full-width and
// appends the "Most recently published" label.
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { tagToSlug, type Post } from '../lib/posts';

interface Props {
	post: Post;
	featured?: boolean;
	activeTag?: string;
}

const { post, featured = false, activeTag } = Astro.props;
const { title, pubDate, heroImage, tags } = post.data;
const tagMode = activeTag !== undefined;
---

<li class:list={[{ featured }]}>
	<a href={`/blog/${post.id}/`}>
		{heroImage && <Image width={720} height={360} src={heroImage} alt="" />}
		<h4 class="title">{title}</h4>
		<p class="date">
			<FormattedDate date={pubDate} />
		</p>
	</a>
	{(tags.length > 0 || featured) && (
		<div class:list={['tags', tagMode ? 'tags--current' : 'tags--interactive']}>
			{tags.map((tag) => (
				<a
					href={tagMode && tag === activeTag ? '/blog' : `/blog/tag/${tagToSlug(tag)}/`}
					class:list={['tag', { active: tagMode && tag === activeTag }]}
				>{tag}</a>
			))}
			{featured && <span class="featured-label">Most recently published</span>}
		</div>
	)}
</li>

<style>
	li {
		width: calc(50% - 1rem);
	}
	li * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	li.featured {
		width: 100%;
		margin-bottom: 1rem;
		text-align: center;
	}
	li.featured img {
		width: 100%;
	}
	li.featured .title {
		font-size: 2.369rem;
	}
	li img {
		margin-bottom: 0.5rem;
		border-radius: 12px;
	}
	li > a {
		display: block;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
	}
	a:hover h4,
	a:hover .date {
		color: rgb(var(--accent));
	}
	a:hover img {
		box-shadow: var(--box-shadow);
	}
	.featured-label {
		margin-left: auto;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--accent);
		border: 2px solid var(--accent);
		border-radius: 10px;
		padding: 0.2em 0.75em;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35em;
		margin-top: 0.4em;
	}
	.tag {
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.15em 0.6em;
		border-radius: 999px;
		background: transparent;
		border: 2px solid var(--accent);
		color: var(--accent);
		text-decoration: none;
		transition: background 0.2s ease, color 0.2s ease;
	}
	/* Interactive (blog index) chips fill on hover; current (tag page) chips fill
	   only the active tag and have no hover state. */
	.tags--interactive .tag:hover {
		background: var(--accent);
		color: #fff;
	}
	.tags--current .tag.active {
		background: var(--accent);
		color: #fff;
	}
	@media (max-width: 720px) {
		li {
			width: 100%;
			text-align: center;
		}
		li.featured {
			margin-bottom: 0;
		}
		li.featured .title {
			font-size: 1.563em;
		}
	}
</style>
