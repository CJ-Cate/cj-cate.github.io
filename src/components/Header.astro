---
import { SITE_TITLE } from '../consts';
import GithubIcon from './icons/GithubIcon.astro';

const pathname = Astro.url.pathname;

const navLinks: { href: string; label: string; isActive: (path: string) => boolean }[] = [
	{ href: '/', label: 'Home', isActive: (p) => p === '/' },
	{ href: '/blog', label: 'Blog', isActive: (p) => p.startsWith('/blog') },
	{ href: '/about', label: 'About Me', isActive: (p) => p === '/about' },
];
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-links">
			{navLinks.map(({ href, label, isActive }) => (
				<a href={href} class:list={[{ active: isActive(pathname) }]}>{label}</a>
			))}
		</div>
		<div class="social-links">
			{pathname !== '/' && pathname !== '/about' && <form action="/search" method="get" class="search-form">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="search-icon" aria-hidden="true">
					<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
				</svg>
				<input type="search" name="q" placeholder="Search…" aria-label="Search" />
			</form>}
			<button id="theme-toggle" aria-label="Toggle dark mode">
				<svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
				</svg>
				<svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
				</svg>
			</button>
			<a href="https://github.com/CJ-Cate" target="_blank">
				<span class="sr-only">Go to CJ's GitHub profile</span>
				<GithubIcon />
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--header-bg);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		display: flex;
		align-items: center;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		--nav-item-gap: 0.75em;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: stretch;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--gray-dark));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.nav-links {
		display: flex;
		align-items: stretch;
		gap: 0.25em;
		justify-content: center;
	}
	.nav-links a {
		display: flex;
		align-items: center;
		font-size: 1.1rem;
		font-weight: 700;
	}
	.social-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: var(--nav-item-gap);
	}
	.social-links a {
		display: flex;
		align-items: center;
	}
	.search-form {
		display: flex;
		align-items: center;
		position: relative;
	}
	.search-icon {
		position: absolute;
		left: 0.55em;
		color: rgb(var(--gray));
		pointer-events: none;
		flex-shrink: 0;
	}
	.search-form input {
		font-size: 0.85rem;
		padding: 0.3em 0.7em 0.3em 2.3em;
		border: 1px solid rgb(var(--gray));
		border-radius: 6px;
		background: transparent;
		color: rgb(var(--black));
		width: 160px;
		outline: none;
		transition: border-color 0.2s ease, width 0.2s ease;
	}
	.search-form input::placeholder {
		color: rgb(var(--gray));
	}
	.search-form input:focus {
		border-color: rgb(var(--black));
		width: 220px;
	}
	#theme-toggle {
		background: none;
		border: 2px solid rgb(var(--gray));
		border-radius: 22%;
		cursor: pointer;
		padding: 0.35em;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		transition: border-color 0.2s ease;
	}
	#theme-toggle:hover {
		border-color: rgb(var(--black));
	}
	#icon-sun,
	#icon-moon {
		display: none;
	}
	:global([data-theme='light']) #icon-moon,
	:global([data-theme='dark']) #icon-sun {
		display: block;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>

<script>
	import { tagToSlug } from '../lib/tags';

	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme');
		const next = current === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
	});

	const searchForm = document.querySelector('.search-form') as HTMLFormElement | null;
	searchForm?.addEventListener('submit', (e) => {
		const input = searchForm.querySelector('input[name="q"]') as HTMLInputElement | null;
		const query = input?.value.trim() ?? '';
		if (query.startsWith('#')) {
			e.preventDefault();
			const tag = query.slice(1).trim();
			if (tag) window.location.href = `/blog/tag/${tagToSlug(tag)}/`;
		}
	});
</script>
