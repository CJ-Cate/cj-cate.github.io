---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts, tagToSlug } from '../lib/posts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await getPublishedPosts();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main>
		<section class="intro">
			<h1>Hi, I'm CJ!</h1>
			<p>
				I am a hacker, mathematician, and pianist. Since forever I have absolutely loved breaking computers and pushing math to the limits. Currently I spend my days hacking and playing piano while going to college.
			</p>
			<p>
				This blog is my place to share some interesting things with the world! Feel free to use, with credit, anything anywhere. If you look closely you may even find some secrets...
			</p>
			<p>
				Contact me: bWVAY2pjYXRlLmNvbQo=
			</p>
		</section>

		<section class="posts">
			<h3>Recent Blog Posts</h3>
			<ul>
				{posts.slice(0, 3).map((post) => (
					<li>
						<div class="card">
							<a href={`/blog/${post.id}/`} class="card-link" aria-label={post.data.title}></a>
							<div class="card-content">
								<div class="post-content">
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.description && <p class="description">{post.data.description}</p>}
									{post.data.tags.length > 0 && (
										<div class="tags">
											{post.data.tags.map((tag) => (
												<a href={`/blog/tag/${tagToSlug(tag)}/`} class="tag">{tag}</a>
											))}
										</div>
									)}
								</div>
								<div class="thumbnail">
									{post.data.heroImage
										? <Image src={post.data.heroImage} alt="" width={120} height={80} />
										: <div class="thumbnail-placeholder" />
									}
								</div>
							</div>
						</div>
					</li>
				))}
			</ul>
			<div class="more-link">
				<a href="/blog">Please, show me more! →</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	.intro {
		margin-bottom: 3rem;
	}
	.intro h1 {
		margin: 0 0 1rem;
	}
	.intro p {
		color: rgb(var(--gray-dark));
		line-height: 1.7;
		margin: 0 0 1rem;
	}
	.posts h3 {
		margin: 0 0 1.5rem;
	}
	.more-link {
		display: flex;
		justify-content: flex-end;
		margin-top: 1rem;
	}
	.more-link a {
		color: var(--accent);
		text-decoration: none;
		font-size: 0.95rem;
	}
	.more-link a:hover {
		text-decoration: underline;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.card {
		position: relative;
		padding: 1rem;
		border-radius: 8px;
		background: rgb(var(--gray-light));
		border: 2px solid transparent;
		transition: border-color 0.2s ease;
	}
	.card:hover {
		border-color: var(--accent);
	}
	.card-link {
		position: absolute;
		inset: 0;
		border-radius: 8px;
		z-index: 1;
	}
	.card-content {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.post-content {
		flex: 1;
		min-width: 0;
	}
	.thumbnail {
		flex-shrink: 0;
		margin-left: auto;
		width: 180px;
		height: 120px;
		border-radius: 6px;
		overflow: hidden;
	}
	.thumbnail img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 6px;
	}
	.thumbnail-placeholder {
		width: 100%;
		height: 100%;
		background: rgb(var(--gray));
		border-radius: 6px;
		opacity: 0.3;
	}
	.card:hover .title {
		color: var(--accent);
	}
	.title {
		margin: 0 0 0.25rem;
		color: rgb(var(--black));
		font-size: 1.25rem;
	}
	.date {
		margin: 0 0 0.5rem;
		color: rgb(var(--gray));
		font-size: 0.875rem;
	}
	.description {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
	}
	.tags {
		position: relative;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35em;
		margin-top: 0.6em;
	}
	.tag {
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.15em 0.6em;
		border-radius: 999px;
		background: transparent;
		border: 2px solid var(--accent);
		color: var(--accent);
		text-decoration: none;
	}
</style>
