---
// The single source of truth for the page shell: doctype, <html>/<head>/<body>,
// global metadata, and the Header/Footer chrome. Pages render their own <main>
// (or other content) into the default slot, which keeps page-scoped `main`
// styles working since the <main> element stays owned by the page.
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<slot name="head" />
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
